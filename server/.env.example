PORT=5000
NODE_ENV=development
TRUST_PROXY=false
# Replace with the private connection string from your managed MongoDB console.
MONGO_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@cluster.example.mongodb.net/lifenet?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CLIENT_URL=http://localhost:5173,http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
